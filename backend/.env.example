# ==============================================================================
# DairyFarm AIoT Backend - Environment Variables Template
# Copy this file to .env and configure for your deployment environment
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# MongoDB Database Connection
# Local: mongodb://localhost:27017/dairyfarm_aiot
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/dairyfarm_aiot

# JWT Authentication
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# CORS Allowed Origins
# Comma-separated list of allowed origins (e.g. https://your-app.vercel.app,http://localhost:5173)
# Set to * or leave blank to permit all origins
CORS_ORIGIN=http://localhost:5173

# Optional: Fallback Environment Credentials
ADMIN_EMAIL=admin@nexadairy.com
ADMIN_PASSWORD=your_secure_admin_password
